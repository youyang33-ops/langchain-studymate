# ============ 方案一（推荐新手）：阿里云百炼 / 通义千问 ============
# 一个 Key 同时提供聊天模型和 Embedding，新用户有免费额度
# 获取 Key：https://bailian.console.aliyun.com
LLM_API_KEY=sk-你的百炼key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 第 7 课：重排序模型（可选）。不配置则不重排；第 7 课会用大模型打分来演示原理
# 注意：gte-rerank 已于 2026-05-30 下线，请使用 qwen3-rerank
RERANK_MODEL=qwen3-rerank
# 如果默认地址调用失败，请到百炼控制台查看你所在地域 / 业务空间的 rerank 接口地址并填在这里
# RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# ============ 方案二：DeepSeek 做聊天模型 ============
# DeepSeek 没有 Embedding 接口，所以 Embedding 仍需要单独配置（例如用百炼）
# LLM_API_KEY=sk-你的deepseek key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# EMBEDDING_API_KEY=sk-你的百炼key
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3

# ============ 可选：LangSmith 链路追踪 ============
# 设置后，每次调用的完整轨迹（提示词、工具调用、耗时、token）都会出现在 smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_你的key
# LANGSMITH_PROJECT=studymate
